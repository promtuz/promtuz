# Project shell environment, applied by direnv on entering this directory and
# undone on leaving. Committed on purpose — it holds no secrets, only the paths
# that differ between machines.
#
# One-time setup, per machine:
#   macOS   brew install direnv
#   Arch    sudo pacman -S direnv
#   both    add to ~/.zshrc:   eval "$(direnv hook zsh)"
#   then    direnv allow
#
# Without direnv nothing here applies and everything still works — you just
# spell the path out: ./tools/scripts/keys status
#
# Note that direnv only exports variables; shell aliases and functions do not
# survive it. So `keys` is a real executable on PATH, not an alias.

PATH_add tools/scripts

# Gradle and keytool both want JDK 21. macOS ships no system JDK at all, so
# Android Studio's bundled runtime is the only one actually present; Arch puts
# it under /usr/lib/jvm. First hit wins, and an inherited JAVA_HOME always does.
if [ -z "${JAVA_HOME:-}" ]; then
    for _jdk in \
        "/Applications/Android Studio.app/Contents/jbr/Contents/Home" \
        /usr/lib/jvm/java-21-openjdk \
        /usr/lib/jvm/java-21-openjdk-amd64 \
        /opt/android-studio/jbr
    do
        if [ -x "$_jdk/bin/javac" ]; then
            export JAVA_HOME="$_jdk"
            break
        fi
    done
    unset _jdk
fi

# Where `keys` looks for the key vault. The script defaults to the same path,
# so this only needs uncommenting if you clone the vault somewhere else.
# export PZ_VAULT="$HOME/.promtuz-vault"
