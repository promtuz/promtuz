[Unit]
Description=Promtuz push gateway (blind FCM/APNs background-wake node)
Documentation=https://github.com/promtuz/promtuz
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pzgateway
Group=pzgateway
ExecStart=/usr/bin/pzgateway --config /etc/promtuz/gateway.toml
WorkingDirectory=/etc/promtuz
Restart=on-failure
RestartSec=2

# Writes keys and CSRs under /etc/promtuz and databases under /var/lib/pzgateway.
# Network access is required for QUIC and HTTPS to FCM and object storage.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6
ConfigurationDirectory=promtuz
StateDirectory=pzgateway
StateDirectoryMode=0700
ReadWritePaths=/var/lib/pzgateway /etc/promtuz

[Install]
WantedBy=multi-user.target
