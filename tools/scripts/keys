#!/usr/bin/env zsh
# Promtuz key vault — mint, store and hand out the four secrets this project
# cannot regenerate. A git repo of age-encrypted files, cloned on every machine
# that needs to sign something.
#
#   keys vault-init [remote]  create the vault (asks for a passphrase), optionally push
#   keys clone <remote>       set this machine up against an existing vault
#   keys adopt <dir> [remote] take an existing plain-directory vault into git
#   keys sync                 pull, then push
#   keys mint-ca              root CA          -> vault, and .tls/RootCA.pem into the repo
#   keys mint-android         release keystore -> vault
#   keys mint-apt             APT repo GPG key -> vault, public .asc alongside
#   keys mint-manifest        update-manifest Ed25519 key -> vault, prints the Rust literal
#   keys ca-sign <csr> [--cap X]  sign a node CSR with the vaulted root CA
#   keys install-ca               put the vault's RootCA.pem into .tls/ for the build
#   keys install-android      put the signing keystore into android/ for daily builds
#   keys get <item> <dest>    decrypt one item to a path
#   keys status               what is present, what is missing, and git state
#
# ── Why it is shaped like this ────────────────────────────────────────────
# One human secret exists: the vault passphrase. It protects a single age
# identity; that identity encrypts everything else. So a release run prompts
# once, not once per key — and rotating the passphrase re-encrypts one small
# file rather than the whole vault.
#
# Git, not a sync folder. Sync propagates a delete or a bad overwrite to every
# machine in seconds and keeps no history — which is the failure this vault
# exists to survive. Git gives history, and a clone on each machine means the
# copies are a side effect of normal use rather than a chore.
#
# The remote is untrusted by construction. Every secret is age-encrypted before
# it is written, so whoever hosts the repo holds ciphertext only. That is what
# makes a private repo on someone else's infrastructure an acceptable home —
# and it is also why the passphrase has to be strong (see vault-init).
#
# The vault's .gitignore is an allowlist: anything not explicitly permitted is
# ignored, so a plaintext key accidentally left in the directory cannot be
# committed by a stray `git add -A`.
#
# Secrets are decrypted only into a 0700 temp dir that an EXIT trap removes,
# and are never echoed. The generated passwords are machine-made and go
# straight into the vault — no human ever reads or types them.

set -euo pipefail

# Captured at script scope: inside a zsh function $0 is the function's name.
# :A not :a — it resolves symlinks, so REPO still points at the project when
# this is invoked through a link (tools/scripts/keys, or one in ~/bin).
SCRIPT="${0:A}"

VAULT="${PZ_VAULT:-$HOME/.promtuz-vault}"

IDENTITY="$VAULT/identity.age"       # age identity, passphrase-encrypted — the root of the vault
RECIPIENT="$VAULT/recipient.txt"     # its public half; plaintext, not a secret
FINGERPRINTS="$VAULT/FINGERPRINTS.txt"

REPO="$(git -C "${SCRIPT:h}" rev-parse --show-toplevel)"

# Android Studio ships the only JDK on this machine; Gradle and keytool both
# want 21, which is exactly what its bundled runtime is.
JAVA_HOME="${JAVA_HOME:-/Applications/Android Studio.app/Contents/jbr/Contents/Home}"
[[ -x "$JAVA_HOME/bin/keytool" ]] || JAVA_HOME="${JAVA_HOME_OVERRIDE:-$(/usr/libexec/java_home 2>/dev/null || print -r -- "")}"
KEYTOOL="$JAVA_HOME/bin/keytool"

# ── output ───────────────────────────────────────────────────────────────
_info() { print -r -- "  $*" }
_ok()   { print -r -- "✓ $*" }
_warn() { print -r -- "! $*" >&2 }
_die()  { print -r -- "✗ $*" >&2; exit 1 }

_need() {
    command -v "$1" >/dev/null 2>&1 || _die "missing '$1' — install it (brew/pacman: $2)"
}

# ── vault primitives ─────────────────────────────────────────────────────

# A 0700 scratch dir that dies with the script. Every decrypted secret lands
# here and nowhere else. APFS and btrfs are both copy-on-write so an
# overwrite-on-delete would be theatre; the honest mitigation is a short window.
_scratch() {
    local d
    d="$(mktemp -d)"
    chmod 700 "$d"
    print -r -- "$d"
}

_git() { git -C "$VAULT" "$@" }

_is_repo() { [[ -d "$VAULT/.git" ]] }

# Commit whatever the mint just wrote, then try to push. A key that exists on
# one machine only is the state this vault is meant to prevent, so a failed
# push is loud rather than silent.
_vault_commit() {
    local msg="$1"
    _is_repo || { _warn "vault is not a git repo — nothing committed"; return 0 }

    _git add -A
    _git diff --cached --quiet && { _info "nothing to commit"; return 0 }
    # commit.gpgsign=false explicitly: these are machine-made bookkeeping
    # commits, and a global signing config would make writing a key to the
    # vault depend on a personal GPG key being present and unlocked. When that
    # fails it fails HALFWAY — files written, commit refused — which is the
    # worst outcome for a vault. Robustness beats a signature the encryption
    # already makes redundant.
    _git -c user.name="${GIT_AUTHOR_NAME:-promtuz-keys}" \
         -c user.email="${GIT_AUTHOR_EMAIL:-keys@promtuz.dev}" \
         -c commit.gpgsign=false \
         commit -q -m "$msg"
    _ok "committed: $msg"

    _git remote get-url origin >/dev/null 2>&1 || {
        _warn "no 'origin' remote — this vault exists on THIS MACHINE ONLY."
        _warn "Add one and push before you rely on it:"
        _warn "  git -C $VAULT remote add origin <url> && git -C $VAULT push -u origin HEAD"
        return 0
    }

    if _git push -q origin HEAD 2>/dev/null; then
        _ok "pushed to origin"
    else
        _warn "PUSH FAILED — the key exists only on this machine right now."
        _warn "Fix the remote and run: keys sync"
    fi
}

# Decrypt the age identity into $1 and echo its path. The single passphrase
# prompt of any run happens here. A typo costs an attempt; age exits 130 when
# the prompt is interrupted, so Ctrl-C still aborts immediately.
#
# Diagnostics go to stderr — stdout carries the identity path back to the caller.
_unlock() {
    local scratch="$1"
    [[ -e "$IDENTITY" ]] || _die "no vault identity at $IDENTITY — run 'keys vault-init' or 'keys clone <remote>'"
    local id="$scratch/identity"
    local tries=3 attempt rc
    _info "unlocking the vault…" >&2
    for attempt in {1..$tries}; do
        age -d -o "$id" "$IDENTITY"
        rc=$?
        (( rc == 0 )) && break
        (( rc == 130 )) && _die "cancelled"
        (( attempt == tries )) && _die "could not unlock the vault after $tries attempts"
        _warn "wrong passphrase — $(( tries - attempt )) attempt(s) left" >&2
    done
    chmod 600 "$id"
    print -r -- "$id"
}

_vault_has() { [[ -e "$VAULT/$1" ]] }

_require_vault() {
    [[ -e "$RECIPIENT" ]] || _die "no vault at $VAULT — run 'keys vault-init' or 'keys clone <remote>'"
}

# Encrypt $1 into the vault as $2. Refuses to replace an existing item: an
# overwritten key here is unrecoverable, so displacing one is left as a
# deliberate act.
_vault_put() {
    local src="$1" name="$2"
    _vault_has "$name" && _die "$name already in the vault — move it aside before minting another"
    age -r "$(<"$RECIPIENT")" -o "$VAULT/$name" "$src"
    _ok "vault: $name"
}

# Copy a non-secret companion (a public cert or key) in verbatim.
_vault_put_plain() {
    local src="$1" name="$2"
    _vault_has "$name" && _die "$name already in the vault — move it aside first"
    cp "$src" "$VAULT/$name"
    _ok "vault: $name (public)"
}

_fp() { print -r -- "$*" >> "$FINGERPRINTS" }

_stamp() { date -u "+%Y-%m-%dT%H:%M:%SZ" }

# Allowlist, not denylist. Everything is ignored unless named here, so a
# decrypted key left lying in the vault cannot be swept up by `git add -A`.
_write_gitignore() {
    cat > "$VAULT/.gitignore" <<'EOF'
# Allowlist. Anything not named below is ignored, so a plaintext key left in
# this directory can never be committed by accident.
*
!.gitignore
!FINGERPRINTS.txt
!recipient.txt
!*.age
!RootCA.pem
!promtuz-archive-keyring.asc
!update-manifest.pub
EOF
}

# ── subcommands ──────────────────────────────────────────────────────────

cmd_vault_init() {
    _need age age
    _need git git

    [[ -e "$IDENTITY" ]] && _die "vault already initialised at $VAULT"

    local remote="${1:-}"

    mkdir -p "$VAULT"
    local scratch; scratch="$(_scratch)"
    trap "rm -rf '$scratch'" EXIT INT TERM

    _is_repo || { _git init -q -b main; _ok "git repo initialised" }
    _write_gitignore

    age-keygen -o "$scratch/identity" 2>"$scratch/pub"
    grep -o 'age1[0-9a-z]*' "$scratch/pub" > "$RECIPIENT"

    print -r -- ""
    print -r -- "Choose the vault passphrase."
    print -r -- ""
    print -r -- "This is the ONE secret you must remember. It cannot be reset, and because"
    print -r -- "the vault lives in a hosted git repo, it is the only thing standing between"
    print -r -- "that host and your root CA — so make it long and random, not memorable."
    print -r -- "Leave it empty and age will generate a strong one and show it to you."
    print -r -- ""
    print -r -- "Put it in your password manager BEFORE you continue."
    print -r -- ""
    age -p -o "$IDENTITY" "$scratch/identity" || _die "encryption cancelled — nothing written"

    cat > "$FINGERPRINTS" <<EOF
Promtuz key vault — index and fingerprints.

Plaintext on purpose: nothing here is secret, and it is how you see what the
vault holds without decrypting anything.

vault created           $(_stamp)
age recipient           $(<"$RECIPIENT")

EOF

    if [[ -n "$remote" ]]; then
        _git remote add origin "$remote"
        _info "remote: $remote"
    fi

    _vault_commit "vault: initialise"

    print -r -- ""
    _ok "vault initialised at $VAULT"
    _info "identity.age      the passphrase-protected age key"
    _info "recipient.txt     $(<"$RECIPIENT")"
    print -r -- ""
    if [[ -z "$remote" ]]; then
        _warn "No remote set. Create a PRIVATE repo and attach it:"
        _warn "  git -C $VAULT remote add origin <url>"
        _warn "  git -C $VAULT push -u origin main"
    fi
    _warn "Verify the repo is private before pushing. The files are encrypted,"
    _warn "but a public one advertises exactly what you hold and invites offline"
    _warn "cracking of the passphrase."
}

cmd_clone() {
    _need git git
    local remote="${1:-}"
    [[ -n "$remote" ]] || _die "usage: keys clone <remote-url>"
    [[ -e "$VAULT" ]] && _die "$VAULT already exists"

    git clone -q "$remote" "$VAULT"
    _ok "vault cloned to $VAULT"
    cmd_status
}

# Take a vault that predates the git layout (a plain synced folder) and turn it
# into the git-backed one, without trusting the source directory's contents:
# only known item names are carried over, so a plaintext key or stray export
# left in there is left behind rather than committed and pushed.
cmd_adopt() {
    _need git git
    local src="${1:-}" remote="${2:-}"
    [[ -n "$src" ]] || _die "usage: keys adopt <source-dir> [remote-url]"
    [[ -d "$src" ]] || _die "no such directory: $src"
    [[ -e "$IDENTITY" ]] && _die "a vault already exists at $VAULT"
    [[ -e "$src/identity.age" ]] || _die "$src has no identity.age — that is not a vault"

    mkdir -p "$VAULT"

    local -a known=(
        identity.age recipient.txt FINGERPRINTS.txt
        RootCA.key.age RootCA.pem
        android-release.p12.age android-keystore.properties.age
        apt-signing-secret.asc.age promtuz-archive-keyring.asc
        update-manifest.key.age update-manifest.pub
    )
    local f carried=0 skipped=()
    for f in $known; do
        if [[ -e "$src/$f" ]]; then
            cp "$src/$f" "$VAULT/$f"
            _ok "carried $f"
            # Not (( carried++ )): that returns the PRE-increment value as its
            # exit status, so the first copy would exit 0-as-false and set -e
            # would kill the adopt half done.
            carried=$(( carried + 1 ))
        else
            skipped+=("$f")
        fi
    done
    (( carried > 0 )) || _die "nothing carried — is $src really a vault?"

    # Name what was left behind, both the expected gaps and anything the
    # allowlist refused, so "adopted" never quietly means "partially adopted".
    [[ ${#skipped} -eq 0 ]] || _info "not present in source: ${skipped[*]}"
    local extra
    extra="$(/bin/ls -A "$src" 2>/dev/null | grep -vxF -f <(print -l -- $known) || true)"
    [[ -z "$extra" ]] || {
        _warn "LEFT BEHIND (not on the allowlist) — check these by hand:"
        print -r -- "$extra" | sed 's/^/    /' >&2
    }

    _is_repo || { _git init -q -b main; _ok "git repo initialised" }
    _write_gitignore
    [[ -z "$remote" ]] || { _git remote add origin "$remote"; _info "remote: $remote" }
    _vault_commit "vault: adopt from $src"

    print -r -- ""
    _ok "vault adopted at $VAULT"
    _warn "The old copy at $src is untouched. Delete it once you have confirmed"
    _warn "the new one works — 'keys status', then a 'keys get' of one item."
}

cmd_sync() {
    _is_repo || _die "no vault repo at $VAULT"
    _git remote get-url origin >/dev/null 2>&1 || _die "no 'origin' remote set"

    # Commit first. A mint that wrote its files but failed to commit leaves the
    # only copy of a key sitting untracked in a working tree — sync is where
    # that gets rescued, so it must not just push around it.
    _git diff --quiet && _git diff --cached --quiet && [[ -z "$(_git ls-files -o --exclude-standard)" ]] \
        || _vault_commit "vault: sync pending changes"

    _git pull -q --rebase origin HEAD && _ok "pulled"
    _git push -q origin HEAD && _ok "pushed"
}

cmd_mint_ca() {
    _require_vault
    _vault_has RootCA.key.age && _die "a root CA is already in the vault"

    local certgen="$REPO/target/release/certgen"
    [[ -x "$certgen" ]] || {
        _info "building certgen…"
        (cd "$REPO" && cargo build --release --bin certgen --features certgen)
    }

    local scratch; scratch="$(_scratch)"
    trap "rm -rf '$scratch'" EXIT INT TERM

    (cd "$scratch" && "$certgen" init)

    _vault_put "$scratch/RootCA.key" RootCA.key.age
    _vault_put_plain "$scratch/RootCA.pem" RootCA.pem

    # The cert is not just an archived artefact: libcore include_bytes!'s it and
    # the relay .deb ships it as /etc/promtuz/ca.pem, so the repo copy is what
    # actually reaches devices.
    #
    # Keep whatever was there. .tls is gitignored, so the outgoing cert exists
    # in exactly one place on disk and `git checkout` cannot bring it back —
    # and it stays the only way to recognise a node still holding an old cert.
    mkdir -p "$REPO/.tls"
    if [[ -e "$REPO/.tls/RootCA.pem" ]]; then
        local retired=".tls/RootCA.pem.retired-$(date -u +%Y%m%d)"
        mv "$REPO/.tls/RootCA.pem" "$REPO/$retired"
        _info "previous cert kept at $retired"
    fi
    cp "$scratch/RootCA.pem" "$REPO/.tls/RootCA.pem"
    _ok "repo: .tls/RootCA.pem"

    local fp
    fp="$(openssl x509 -in "$scratch/RootCA.pem" -noout -fingerprint -sha256 | cut -d= -f2)"
    _fp "root CA                 $(_stamp)"
    _fp "  SHA-256               $fp"
    _fp "  subject               $(openssl x509 -in "$scratch/RootCA.pem" -noout -subject | cut -d= -f2-)"
    _fp "  expires               $(openssl x509 -in "$scratch/RootCA.pem" -noout -enddate | cut -d= -f2)"
    _fp ""

    _vault_commit "add root CA ($fp)"

    print -r -- ""
    _warn "Every relay/resolver/gateway cert signed by the OLD CA is now worthless."
    _warn "Rebuild libcore and the .debs, then re-enroll each node (certgen sign)."
}

cmd_mint_android() {
    _require_vault
    _need openssl openssl
    [[ -x "$KEYTOOL" ]] || _die "no keytool found — set JAVA_HOME to a JDK 21"
    _vault_has android-release.p12.age && _die "an Android release key is already in the vault"

    local scratch; scratch="$(_scratch)"
    trap "rm -rf '$scratch'" EXIT INT TERM

    # 192 bits of hex. Machine-generated and written straight to the vault, so
    # this password is never typed, displayed, or shoulder-surfed — the vault
    # passphrase is the only thing standing in front of it.
    local pw; pw="$(openssl rand -hex 24)"
    local ks="$scratch/android-release.p12"

    # Password over stdin rather than -storepass, which would put it in the
    # process table for anyone running ps at the wrong moment.
    _info "generating a 4096-bit RSA signing key (30 years)…"
    printf '%s\n%s\n' "$pw" "$pw" | "$KEYTOOL" -genkeypair \
        -keystore "$ks" -storetype PKCS12 -alias promtuz \
        -keyalg RSA -keysize 4096 -sigalg SHA256withRSA \
        -validity 10950 \
        -dname "CN=Promtuz, O=Promtuz, C=IN" >/dev/null 2>&1 \
        || _die "keytool failed"

    # Exactly the keys android/app/build.gradle.kts already reads. storeFile is
    # a bare name so that dropping both files into android/ works as-is —
    # Gradle resolves it against the root project.
    cat > "$scratch/keystore.properties" <<EOF
storeFile=android-release.p12
storePassword=$pw
keyAlias=promtuz
keyPassword=$pw
EOF

    _vault_put "$ks" android-release.p12.age
    _vault_put "$scratch/keystore.properties" android-keystore.properties.age

    # The signer digest the updater compares against (UpdateRepository.signers()).
    # Recorded because after this rotation it is the only way to tell, from an
    # APK alone, whether it came from the new key or the dead one.
    local sha
    sha="$(printf '%s\n' "$pw" | "$KEYTOOL" -list -v -keystore "$ks" 2>/dev/null \
        | awk '/SHA256:/ {print $2; exit}')"

    _fp "android release key     $(_stamp)"
    _fp "  cert SHA-256          $sha"
    _fp "  alias                 promtuz"
    _fp "  algorithm             RSA-4096 / SHA256withRSA, 10950 days"
    _fp ""

    _vault_commit "add android release key ($sha)"

    _ok "signer cert SHA-256: $sha"
    print -r -- ""
    _warn "This replaces a key that is GONE. Installed copies of Promtuz cannot"
    _warn "update to anything signed with it — they must uninstall and reinstall,"
    _warn "which wipes the identity, the DB, and the Auto Backup blob."
}

cmd_mint_apt() {
    _require_vault
    _need gpg gnupg
    _vault_has apt-signing-secret.asc.age && _die "an APT key is already in the vault"

    local scratch; scratch="$(_scratch)"
    trap "rm -rf '$scratch'" EXIT INT TERM

    # A throwaway GNUPGHOME: the repo key has no business in the invoking
    # user's own keyring, and nothing lingers after the export.
    #
    # Passed per-command rather than exported. An exported GNUPGHOME would
    # escape this function and reach the git commit below, which would then
    # look for the committer's signing key in a keyring that has never held
    # it.
    local gnupg="$scratch/gnupg"
    mkdir -p "$gnupg"; chmod 700 "$gnupg"

    # RSA-4096 to match the key it replaces — Debian 10 is the stated floor and
    # this is the option no gpgv in that range can object to.
    #
    # %no-protection on purpose: a passphrase here would be a SECOND human
    # secret guarding a key that is already inside the age vault, and every
    # unattended repo signing would have to smuggle it in somehow.
    cat > "$scratch/params" <<'EOF'
%echo generating APT repo signing key
Key-Type: RSA
Key-Length: 4096
Key-Usage: sign
Name-Real: Promtuz Apt Repo
Name-Email: apt@promtuz.dev
Expire-Date: 5y
%no-protection
%commit
%echo done
EOF

    _info "generating a 4096-bit RSA repo signing key…"
    GNUPGHOME="$gnupg" gpg --batch --quiet --generate-key "$scratch/params" 2>/dev/null \
        || _die "gpg key generation failed"

    local fpr
    fpr="$(GNUPGHOME="$gnupg" gpg --batch --list-keys --with-colons | awk -F: '/^fpr:/ {print $10; exit}')"

    GNUPGHOME="$gnupg" gpg --batch --armor --export-secret-keys "$fpr" > "$scratch/secret.asc"
    GNUPGHOME="$gnupg" gpg --batch --armor --export "$fpr" > "$scratch/promtuz-archive-keyring.asc"

    _vault_put "$scratch/secret.asc" apt-signing-secret.asc.age
    _vault_put_plain "$scratch/promtuz-archive-keyring.asc" promtuz-archive-keyring.asc

    _fp "APT repo signing key    $(_stamp)"
    _fp "  fingerprint           $fpr"
    _fp "  uid                   Promtuz Apt Repo <apt@promtuz.dev>"
    _fp "  algorithm             RSA-4096, expires in 5 years"
    _fp "  replaces              A34264FD03753895A1F66AA637181C06227D8BAD"
    _fp ""

    _vault_commit "add apt repo signing key ($fpr)"

    _ok "fingerprint: $fpr"
    print -r -- ""
    _warn "Publish promtuz-archive-keyring.asc at the repo root and re-sign the"
    _warn "Release files. Boxes pinned to the old key via signed-by= will fail"
    _warn "'apt update' until /etc/apt/keyrings/promtuz.asc is replaced by hand."
    _warn "Expiry is 5 years — note it, an expired repo key breaks apt silently."
}

cmd_mint_manifest() {
    _require_vault
    _need openssl openssl
    _vault_has update-manifest.key.age && _die "a manifest signing key is already in the vault"

    local scratch; scratch="$(_scratch)"
    trap "rm -rf '$scratch'" EXIT INT TERM

    openssl genpkey -algorithm ed25519 -out "$scratch/update-manifest.key" 2>/dev/null \
        || _die "openssl could not generate an Ed25519 key"

    # libcore verifies against a raw 32-byte public key, which is the tail of
    # the DER SubjectPublicKeyInfo.
    openssl pkey -in "$scratch/update-manifest.key" -pubout -outform DER 2>/dev/null \
        | tail -c 32 > "$scratch/pub.raw"

    local hex; hex="$(xxd -p -c 32 "$scratch/pub.raw")"
    print -r -- "$hex" > "$scratch/update-manifest.pub"

    _vault_put "$scratch/update-manifest.key" update-manifest.key.age
    _vault_put_plain "$scratch/update-manifest.pub" update-manifest.pub

    _fp "update manifest key     $(_stamp)"
    _fp "  ed25519 public (hex)  $hex"
    _fp ""

    _vault_commit "add update manifest signing key ($hex)"

    # Formatted to drop straight into the existing const, 16 bytes per line.
    print -r -- ""
    print -r -- "Replace UPDATE_MANIFEST_PUBLIC_KEY in libcore/src/api/update.rs with:"
    print -r -- ""
    print -r -- "const UPDATE_MANIFEST_PUBLIC_KEY: [u8; 32] = ["
    print -r -- "$hex" | fold -w2 | awk '
        { printf "%s0x%s,", (NR % 16 == 1 ? "    " : " "), $1 }
        NR % 16 == 0 { printf "\n" }
        END { if (NR % 16 != 0) printf "\n" }
    '
    print -r -- "];"
    print -r -- ""
    _warn "Changing this invalidates every manifest signed with the old key."
    _warn "Re-sign the published manifests in the same push as the app release."
}

# libcore include_bytes!'s .tls/RootCA.pem at compile time and the relay .deb
# ships it as /etc/promtuz/ca.pem, so until this runs, a build carries whatever
# CA happens to be sitting in .tls — which after a mint-ca is the OLD one.
cmd_install_ca() {
    _require_vault
    _vault_has RootCA.pem || _die "no RootCA.pem in the vault — run 'keys mint-ca'"

    mkdir -p "$REPO/.tls"
    if [[ -e "$REPO/.tls/RootCA.pem" ]]; then
        if cmp -s "$VAULT/RootCA.pem" "$REPO/.tls/RootCA.pem"; then
            _ok ".tls/RootCA.pem already matches the vault — nothing to do"
            return 0
        fi
        local retired=".tls/RootCA.pem.retired-$(date -u +%Y%m%d)"
        mv "$REPO/.tls/RootCA.pem" "$REPO/$retired"
        _info "previous cert kept at $retired"
    fi
    cp "$VAULT/RootCA.pem" "$REPO/.tls/RootCA.pem"
    _ok "repo: .tls/RootCA.pem"
    _info "$(openssl x509 -in "$REPO/.tls/RootCA.pem" -noout -fingerprint -sha256 | cut -d= -f2)"
    _info "expires $(openssl x509 -in "$REPO/.tls/RootCA.pem" -noout -enddate | cut -d= -f2)"
    print -r -- ""
    _warn "libcore bakes this in at compile time — rebuild before shipping."
}

# Sign a node CSR with the vaulted root CA.
#
# certgen looks for RootCA.{key,pem} in its working directory, so the CA key
# has to exist as a file somewhere. Here that somewhere is a 0700 scratch dir
# an EXIT trap removes — never the repo, never /tmp by hand, and never a copy
# someone forgets to delete. Of every key in this vault, the CA private key is
# the one whose stray copy matters most: it mints identities for the whole
# network.
#
# Nothing is written into the scratch dir either. certgen's no-path mode takes
# the CSR on stdin and emits the certificate on stdout, so the signed result
# never touches a file that would then need cleaning up.
cmd_ca_sign() {
    _require_vault
    _vault_has RootCA.key.age || _die "no root CA in the vault — run 'keys mint-ca'"

    local csr="" out="" caps=()
    while (( $# )); do
        case "$1" in
            --cap) caps+=(--cap "${2:?}"); shift 2 ;;
            -o)    out="${2:?}"; shift 2 ;;
            # Before -*), or the lone dash reads as an unknown flag.
            -)     csr="-"; shift ;;
            -*)    _die "unknown option '$1'" ;;
            *)     csr="$1"; shift ;;
        esac
    done
    [[ -n "$csr" ]] || _die "usage: keys ca-sign <file.csr|-> [--cap <capability>]... [-o out.crt]"
    [[ "$csr" == "-" || -f "$csr" ]] || _die "no such CSR: $csr"

    local certgen="$REPO/target/release/certgen"
    [[ -x "$certgen" ]] || {
        _info "building certgen…" >&2
        (cd "$REPO" && cargo build --release --bin certgen --features certgen) >&2
    }

    local scratch; scratch="$(_scratch)"
    trap "rm -rf '$scratch'" EXIT INT TERM
    local id; id="$(_unlock "$scratch")"

    age -d -i "$id" -o "$scratch/RootCA.key" "$VAULT/RootCA.key.age"
    chmod 600 "$scratch/RootCA.key"
    cp "$VAULT/RootCA.pem" "$scratch/RootCA.pem"

    local src="$csr"
    [[ "$csr" == "-" ]] && src=/dev/stdin

    local cert
    cert="$( (cd "$scratch" && "$certgen" sign "${caps[@]}") < "$src" 2>"$scratch/err" )" \
        || _die "certgen could not sign that CSR:
$(sed 's/^/    /' "$scratch/err")"
    [[ -n "$cert" ]] || _die "certgen produced no certificate"

    # Prove it chains to the vaulted CA before handing it over. A cert that
    # does not verify leaves the node waiting for enrolment indefinitely with
    # no error to point at, which is near-undiagnosable remotely.
    print -r -- "$cert" > "$scratch/out.crt"
    openssl verify -CAfile "$scratch/RootCA.pem" "$scratch/out.crt" >/dev/null 2>&1 \
        || _die "the signed certificate does not verify against the vault's CA"

    local subject
    subject="$(openssl x509 -in "$scratch/out.crt" -noout -subject | sed 's/^subject=[ ]*//')"

    if [[ -n "$out" ]]; then
        cp "$scratch/out.crt" "$out"
        _ok "signed $subject"
        _info "-> $out"
    else
        print -r -- "$cert"
        _ok "signed $subject" >&2
    fi
}

# Debug builds are signed with the release key so they install over each other
# without a wipe, which means Gradle needs that key on every ordinary build —
# Android Studio's Run button included. Prompting for the vault passphrase
# per build is not workable, so the keystore is materialised into android/ and
# left there.
#
# The trade is deliberate and worth naming: the production signing key now sits
# unencrypted on this machine. Losing it is covered — the vault still holds it —
# but anything that can read the working tree can now read the signing key.
cmd_install_android() {
    _require_vault
    _vault_has android-release.p12.age || _die "no Android key in the vault — run 'keys mint-android'"

    local dest="$REPO/android"
    local ks="$dest/android-release.p12" props="$dest/keystore.properties"

    if [[ -e "$ks" || -e "$props" ]]; then
        _warn "signing files already in android/ — replacing them"
    fi

    local scratch; scratch="$(_scratch)"
    trap "rm -rf '$scratch'" EXIT INT TERM
    local id; id="$(_unlock "$scratch")"

    age -d -i "$id" -o "$ks" "$VAULT/android-release.p12.age"
    age -d -i "$id" -o "$props" "$VAULT/android-keystore.properties.age"
    chmod 600 "$ks" "$props"

    _ok "android/android-release.p12   (0600)"
    _ok "android/keystore.properties   (0600)"
    _info "both are gitignored; debug and release now share this signer"

    # Cheap insurance against the gitignore ever regressing — this is the one
    # mistake in this whole flow that cannot be walked back once pushed.
    local tracked
    tracked="$(git -C "$REPO" ls-files --error-unmatch \
        android/android-release.p12 android/keystore.properties 2>/dev/null || true)"
    [[ -z "$tracked" ]] || _die "GIT IS TRACKING THE SIGNING KEY: $tracked — remove it from the index NOW"
    git -C "$REPO" check-ignore -q android/android-release.p12 \
        || _warn "android/android-release.p12 is NOT gitignored — fix that before committing"
}

cmd_get() {
    local item="${1:-}" dest="${2:-}"
    [[ -n "$item" && -n "$dest" ]] || _die "usage: keys get <item> <dest>"
    _vault_has "$item" || _die "no '$item' in the vault"

    if [[ "$item" != *.age ]]; then
        cp "$VAULT/$item" "$dest"
        _ok "$item -> $dest (public, not encrypted)"
        return
    fi

    local scratch; scratch="$(_scratch)"
    trap "rm -rf '$scratch'" EXIT INT TERM
    local id; id="$(_unlock "$scratch")"

    age -d -i "$id" -o "$dest" "$VAULT/$item"
    chmod 600 "$dest"
    _ok "$item -> $dest (0600)"
    _warn "That is plaintext key material. Delete it when you are done."
}

cmd_status() {
    print -r -- "vault: $VAULT"

    if _is_repo; then
        local branch ahead
        branch="$(_git rev-parse --abbrev-ref HEAD 2>/dev/null || print -r -- '?')"
        print -r -- "git:   branch $branch, $(_git rev-list --count HEAD 2>/dev/null || print 0) commits"
        if _git remote get-url origin >/dev/null 2>&1; then
            print -r -- "       origin $(_git remote get-url origin)"
            ahead="$(_git rev-list --count '@{u}..HEAD' 2>/dev/null || print -r -- '?')"
            [[ "$ahead" == "0" ]] || _warn "$ahead commit(s) not pushed — run 'keys sync'"
        else
            _warn "no remote — this vault exists on THIS MACHINE ONLY"
        fi
        _git diff --quiet && _git diff --cached --quiet || _warn "uncommitted changes in the vault"
    else
        print -r -- "git:   not a repo"
    fi
    print -r -- ""

    local -a items=(
        identity.age                        "vault identity (passphrase)"
        recipient.txt                       "age recipient (public)"
        RootCA.key.age                      "root CA private key"
        RootCA.pem                          "root CA cert (public)"
        android-release.p12.age             "Android release keystore"
        android-keystore.properties.age     "  its passwords"
        apt-signing-secret.asc.age          "APT repo signing key"
        promtuz-archive-keyring.asc         "  its public half"
        update-manifest.key.age             "update manifest signing key"
        update-manifest.pub                 "  its public half"
    )

    local i name desc
    for (( i = 1; i <= ${#items[@]}; i += 2 )); do
        name="${items[$i]}"; desc="${items[$i+1]}"
        if _vault_has "$name"; then
            printf '  \033[32m✓\033[0m %-34s %s\n' "$name" "$desc"
        else
            printf '  \033[31m·\033[0m %-34s %s \033[31m(missing)\033[0m\n' "$name" "$desc"
        fi
    done

    if [[ -e "$FINGERPRINTS" ]]; then
        print -r -- ""
        print -r -- "── FINGERPRINTS.txt ──"
        cat "$FINGERPRINTS"
    fi
}

cmd_help() {
    # The usage block is the header comment, down to its first section rule.
    sed -n '2,/^# ──/p' "$SCRIPT" | sed '$d; s/^# \{0,1\}//'
}

case "${1:-help}" in
    vault-init)    shift; cmd_vault_init "$@" ;;
    clone)         shift; cmd_clone "$@" ;;
    adopt)         shift; cmd_adopt "$@" ;;
    sync)          shift; cmd_sync "$@" ;;
    mint-ca)       shift; cmd_mint_ca "$@" ;;
    mint-android)  shift; cmd_mint_android "$@" ;;
    mint-apt)      shift; cmd_mint_apt "$@" ;;
    mint-manifest) shift; cmd_mint_manifest "$@" ;;
    ca-sign)         shift; cmd_ca_sign "$@" ;;
    install-ca)      shift; cmd_install_ca "$@" ;;
    install-android) shift; cmd_install_android "$@" ;;
    get)           shift; cmd_get "$@" ;;
    status)        shift; cmd_status "$@" ;;
    help|-h|--help) cmd_help ;;
    *) _die "unknown command '$1' — try 'keys help'" ;;
esac
